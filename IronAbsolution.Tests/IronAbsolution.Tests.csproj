<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests runs under Microsoft.Testing.Platform (MTP), and `xunit.v3` is the one test
    package (D-40). Coverlet writes the Cobertura file that ReportGenerator reads (D-45).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IronAbsolution.Tests</RootNamespace>
    <AssemblyName>IronAbsolution.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      The generated entry point of `xunit.v3` runs the console runner unless this property
      is on. The console runner reads no extension, so the coverage option of Coverlet fails there.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="coverlet.MTP" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IronAbsolution.Tools/IronAbsolution.Tools.csproj" />
    <!--
      The stub program stands in for a program of the engine (D-103). The tests copy its build
      output, so they need the files and not a reference to the assembly. `ReferenceOutputAssembly`
      is off, and the project reference gives the build order alone.
    -->
    <ProjectReference Include="../IronAbsolution.TestStub/IronAbsolution.TestStub.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Puts the whole build output of the stub program under `stub/` of the test output. A test copies
    that folder beside the path of a program of the engine (D-103). The host of the stub needs its
    own assembly, its runtime configuration, and its dependency list in one folder.
  -->
  <Target Name="CopyTestStub" AfterTargets="Build">
    <ItemGroup>
      <TestStubFile Include="$(MSBuildThisFileDirectory)../IronAbsolution.TestStub/bin/$(Configuration)/$(TargetFramework)/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestStubFile)" DestinationFolder="$(OutDir)stub" SkipUnchangedFiles="true" />
  </Target>

</Project>
