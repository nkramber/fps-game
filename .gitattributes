# One line ending on every platform. The STE checker, the byte rule of AGENTS 1, and diffs
# depend on it (D-40).
* text=auto eol=lf

# Git LFS stores each binary type (D-30, D-86). The `-text` of each rule turns off the line
# ending rule above for that file. `GameFilesTests` reads each rule, so a new type needs a new
# rule and a new line in that test.

# The Unreal package types and bulk data types.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.uptnl filter=lfs diff=lfs merge=lfs -text

