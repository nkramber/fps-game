# The generated folders and the cache folders of Unreal Engine (D-9). Each pattern matches at
# any depth, so it holds `Game/` and each plugin of it. `GameFilesTests` reads these rules.
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# IDE and editor files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# OS files
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
*.dmp
crashinfo*

# Keep source assets, project files, plugins, and config under version control.

# .NET build output and test results of the tools project (D-15)
bin/
obj/
TestResults/
artifacts/
